@page
@model IndexModel
@{
    ViewData["Title"] = "OSS Orchestrator";
    var state = Model.State;
    var tabIssues = state?.Issues.FirstOrDefault(x => x.Repo == Model.Tab);
    string StatusText(string s) => s switch
    {
        "working" => "working",
        "blocked" => "needs your answer",
        "done" => "finished",
        "idle" => "idle",
        _ => "no status",
    };
    string PrStatusClass(string s) => s switch
    {
        "ready" or "merged" => "ok",
        "building" => "info",
        "failed" or "conflicted" => "bad",
        _ => "",
    };
    string SessionClass(string s) => s switch
    {
        "working" => "info",
        "blocked" => "warn",
        "done" => "ok",
        _ => "",
    };
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="15" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/site.css" />
</head>
<body>
<main>
    <header>
        <h1>OSS Orchestrator</h1>
        <nav><a asp-page="/Settings">Settings &rarr;</a></nav>
    </header>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="banner bad">@Model.Error</div>
    }
    @if (state is null && string.IsNullOrEmpty(Model.Error))
    {
        <div class="banner">No status yet. The agent has not written its first pass.</div>
    }
    else if (Model.StateIsStale && state is not null)
    {
        <div class="banner">The agent has not reported for more than 10 minutes (last: @state.At.ToLocalTime().ToString("HH:mm:ss")). It may be stopped.</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="banner">@Model.Message</div>
    }

    <div class="card">
        <div class="kpis">
            <div class="kpi"><b>@(state?.Running ?? 0)</b><span>sessions running</span></div>
            <div class="kpi"><b>@(state?.MaxTotal ?? 0)</b><span>global limit</span></div>
            <div class="kpi"><b>@(state?.Planned.Count ?? 0)</b><span>planned to launch</span></div>
            <div class="kpi"><b>@(state?.DryRun == true ? "dry-run" : "live")</b><span>agent mode</span></div>
        </div>
        @if (state is not null)
        {
            <p class="muted">Last pass: @state.At.ToLocalTime().ToString("HH:mm:ss")</p>
        }
        <div class="toolbar">
            <form method="post" asp-page-handler="Command" class="inline">
                <input type="hidden" name="type" value="pause_all" /><button type="submit">Pause all</button>
            </form>
            <form method="post" asp-page-handler="Command" class="inline">
                <input type="hidden" name="type" value="resume_all" /><button type="submit">Resume all</button>
            </form>
            <form method="post" asp-page-handler="Command" class="inline">
                <input type="hidden" name="type" value="refresh" /><button type="submit">Refresh now</button>
            </form>
        </div>
    </div>

    <div class="card">
        <h2>Working on</h2>
        @if (state is null || state.Sessions.Count == 0)
        {
            <p class="muted">No open sessions.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Repo</th><th>Issue</th><th>Title</th><th>Session</th><th>Session ID</th><th>PR</th><th>PR status</th><th></th></tr></thead>
                <tbody>
                @foreach (var s in state.Sessions)
                {
                    <tr>
                        <td>@s.Repo</td>
                        <td class="num">#@s.Issue</td>
                        <td class="title">@s.Title</td>
                        <td><span class="pill @SessionClass(s.Status)">@StatusText(s.Status)</span></td>
                        <td>
                            @if (s.CloudSessionUrl is not null) { <a href="@s.CloudSessionUrl" target="_blank" rel="noopener">@s.CloudSessionId</a> }
                            else { <span class="muted">local</span> }
                        </td>
                        <td>
                            @if (s.PrUrl is not null)
                            {
                                <a href="@s.PrUrl" target="_blank" rel="noopener">#@s.PrNumber</a>
                                @if (s.PrDraft) { <span class="pill">draft</span> }
                            }
                            else
                            {
                                <span class="muted">no PR yet</span>
                            }
                        </td>
                        <td><span class="pill @PrStatusClass(s.PrStatus)">@s.PrStatus</span></td>
                        <td>
                            @if (s.PrConflict)
                            {
                                <form method="post" asp-page-handler="Command" class="inline">
                                    <input type="hidden" name="type" value="restore" />
                                    <input type="hidden" name="repo" value="@s.Repo" />
                                    <input type="hidden" name="issue" value="@s.Issue" />
                                    <input type="hidden" name="tab" value="@Model.Tab" />
                                    <button type="submit">Restore</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="card">
        <h2>Open issues</h2>
        @if (state is null || state.Issues.Count == 0)
        {
            <p class="muted">No repos yet.</p>
        }
        else
        {
            <nav class="tabs">
                @foreach (var r in state.Issues)
                {
                    <a asp-page="/Index" asp-route-tab="@r.Repo" class="@(r.Repo == Model.Tab ? "tab active" : "tab")">@r.Repo</a>
                }
            </nav>
            @if (tabIssues is null || tabIssues.Items.Count == 0)
            {
                <p class="muted">No open issues in this repo.</p>
            }
            else
            {
                <table>
                    <thead><tr><th>Issue</th><th>Title</th><th>State</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var i in tabIssues.Items)
                    {
                        <tr>
                            <td class="num">#@i.Number</td>
                            <td class="title">@i.Title</td>
                            <td>
                                @if (i.InProgress) { <span class="pill on">in-progress</span> }
                                else if (i.Blocked) { <span class="pill paused">blocked</span> }
                                else if (i.Assigned) { <span class="pill">assigned</span> }
                                else if (i.Ignored) { <span class="pill">ignored</span> }
                                else { <span class="muted">free</span> }
                            </td>
                            <td>
                                @if (i.Blocked)
                                {
                                    <form method="post" asp-page-handler="Command" class="inline">
                                        <input type="hidden" name="type" value="unblock" />
                                        <input type="hidden" name="repo" value="@tabIssues.Repo" />
                                        <input type="hidden" name="issue" value="@i.Number" />
                                        <input type="hidden" name="tab" value="@Model.Tab" />
                                        <button type="submit">Unblock</button>
                                    </form>
                                }
                                else if (!i.Ignored && !i.Assigned && !i.InProgress)
                                {
                                    <form method="post" asp-page-handler="Command" class="inline">
                                        <input type="hidden" name="type" value="ignore" />
                                        <input type="hidden" name="repo" value="@tabIssues.Repo" />
                                        <input type="hidden" name="issue" value="@i.Number" />
                                        <input type="hidden" name="tab" value="@Model.Tab" />
                                        <button type="submit">Ignore</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        }
    </div>

    <div class="card">
        <h2>Recent commands</h2>
        @if (Model.Recent.Count == 0)
        {
            <p class="muted">None yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>When</th><th>Command</th><th>By</th><th>Result</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Recent)
                {
                    <tr>
                        <td class="muted">@c.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                        <td>@c.Type @c.Repo @(c.Issue is null ? "" : "#" + c.Issue)</td>
                        <td class="muted">@c.By</td>
                        <td class="muted">@(c.Processed ? c.Result : "waiting for the agent")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</main>
</body>
</html>
