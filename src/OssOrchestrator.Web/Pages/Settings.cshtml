@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings · OSS Orchestrator";
    var config = Model.Config;
    var state = Model.State;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/site.css" />
</head>
<body>
<main>
    <header>
        <h1>Settings</h1>
        <nav><a asp-page="/Index">&larr; Status</a></nav>
    </header>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="banner bad">@Model.Error</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="banner">@Model.Message</div>
    }

    <div class="card">
        <h2>Global limit</h2>
        <form method="post" asp-page-handler="Command" class="row">
            <input type="hidden" name="type" value="limit" />
            <label class="muted">Sessions at once
                <input type="number" name="value" min="1" max="20" value="@(config?.MaxTotal ?? state?.MaxTotal ?? 6)" />
            </label>
            <button type="submit">Save limit</button>
        </form>
    </div>

    <div class="card">
        <h2>Repos</h2>
        @if (config is null || config.Repos.Count == 0)
        {
            <p class="muted">No repos configured.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Repo</th><th>Auto</th><th>Open issues</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in config.Repos)
                {
                    var status = state?.Repos.FirstOrDefault(x => x.Repo == r.Repo);
                    <tr>
                        <td>@r.Repo</td>
                        <td><span class="pill @(r.Auto ? "on" : "")">@(r.Auto ? "auto on" : "auto off")</span></td>
                        <td class="num">@(status?.OpenIssues ?? 0)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(status?.Error)) { <span class="muted">@status.Error</span> }
                            else if (r.Paused) { <span class="pill paused">paused</span> }
                            else { <span class="pill on">active</span> }
                        </td>
                        <td><div class="controls">
                            <form method="post" asp-page-handler="Command" class="inline">
                                <input type="hidden" name="repo" value="@r.Repo" />
                                <input type="hidden" name="type" value="@(r.Paused ? "resume" : "pause")" />
                                <button type="submit">@(r.Paused ? "Resume" : "Pause")</button>
                            </form>
                            <form method="post" asp-page-handler="Command" class="inline">
                                <input type="hidden" name="repo" value="@r.Repo" />
                                <input type="hidden" name="type" value="auto" />
                                <input type="hidden" name="value" value="@(r.Auto ? "false" : "true")" />
                                <button type="submit">Auto @(r.Auto ? "off" : "on")</button>
                            </form>
                        </div></td>
                    </tr>
                    @if (r.Ignored.Count > 0)
                    {
                        <tr><td colspan="5" class="muted">Ignored: @string.Join(", ", r.Ignored.Select(n => "#" + n))</td></tr>
                    }
                }
                </tbody>
            </table>
        }
    </div>

</main>
</body>
</html>
